{
  "name": "@metexplore/mcp-metexplore",
  "version": "0.0.0",
  "description": "MCP server for querying the MetExplore API (organisms, metabolites, reactions, mapping)",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "metexplore",
    "metabolism",
    "metabolomics",
    "metabolic-network"
  ],
  "homepage": "https://forge.inrae.fr/metexplore/mcp/mcp-metexplore",
  "bugs": {
    "url": "https://forge.inrae.fr/metexplore/mcp/mcp-metexplore/-/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://forge.inrae.fr/metexplore/mcp/mcp-metexplore.git"
  },
  "type": "module",
  "bin": {
    "mcp-metexplore": "dist/index.js"
  },
  "files": [
    "dist",
    ".env.example",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^18.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
