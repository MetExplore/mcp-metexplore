# SPDX-License-Identifier: Apache-2.0
# ---------------------------------------------------------------------------
# MetExplore API
# ---------------------------------------------------------------------------

# Base URL of the MetExplore API (no trailing slash)
# Local test instance:
METEXPLORE_API_URL=http://localhost:1337
# Production: https://metexplore.toulouse.inrae.fr/metexplore3-api

# Application token (required) — x-app-key header
METEXPLORE_APP_KEY=

# User credentials — OPTIONAL, and only used in stdio mode (local use).
# Without them, the API is queried anonymously: only public networks are visible.
# In HTTP mode they are ignored: each client sends its own token in the
# X-MetExplore-Token header.
# Option A: a user token you already obtained (Authorization: Bearer header)
METEXPLORE_USER_TOKEN=
# Option B: login credentials, used to call /users/login on first use
METEXPLORE_USER_LOGIN=
METEXPLORE_USER_PASSWORD=

# Maximum number of requests sent to the MetExplore API per MCP session
# (process lifetime in stdio mode, one MCP session in HTTP mode). Default: 20.
METEXPLORE_MAX_REQUESTS_PER_SESSION=20

# Only disable TLS certificate verification (=false) if you know the target
# MetExplore server has an incomplete certificate chain and you trust it.
# WARNING: this then accepts any certificate (risk of MITM).
# Verification is enabled (true) by default.
METEXPLORE_TLS_REJECT_UNAUTHORIZED=true

# ---------------------------------------------------------------------------
# MCP transport
# ---------------------------------------------------------------------------

# stdio (default, local use) or http (remote deployment, Streamable HTTP on /mcp)
MCP_TRANSPORT=stdio

# HTTP mode only
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
# Comma-separated public hostnames accepted in the Host header (DNS rebinding
# protection). Empty = no check. E.g. mcp.metexplore.example.org
MCP_ALLOWED_HOSTS=
# true when running behind a reverse proxy: the client IP used for rate
# limiting is taken from X-Forwarded-For.
MCP_TRUST_PROXY=false
# Max HTTP requests per client IP per minute on /mcp. Default: 60.
MCP_RATE_LIMIT_PER_MINUTE=60
# Max concurrent MCP sessions. Default: 200.
MCP_MAX_SESSIONS=200
# Idle sessions are closed after this many minutes. Default: 30.
MCP_SESSION_TTL_MINUTES=30
